# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Env
.env

# Downloaded/cached datasets — large binary data, not source
training/data/

# Downloaded pretrained model weights — large binary data, not source
*.pt

# Trained router model artifacts — build output, not source
*.joblib
*.pkl

*/node_modules
*/.expo
# Local experiment scratch space — pilots, logs, throwaway checkpoints
training/scratch/

# MLflow: run history lives in Postgres; these are local by-products, not source.
# The run-id sidecars point at rows in a machine-local database, so they never belong in git.
training/mlartifacts/
*.run.json
