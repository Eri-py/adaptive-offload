{
  "expo": {
    "name": "mobile-inference-benchmark",
    "slug": "mobile-inference-benchmark",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.eriol.adaptiveoffload.bench",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "plugins": [
      [
        "react-native-fast-tflite",
        {
          "enableCoreMLDelegate": true
        }
      ],
      "expo-asset",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to use the camera so you can photograph a bird to identify.",
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos so you can pick a bird picture to identify."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "8417b149-da6c-4786-9069-dd602eaf474d"
      }
    }
  }
}
